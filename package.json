{
  "name": "dsh-agent-observe",
  "version": "0.1.0",
  "description": "Agent observability plugin for DSH — behavior audit, cost tracking, anomaly detection",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "test": "node --test tests/*.test.js tests/*.test.cjs",
    "test:e2e": "DSH_E2E=1 node --test tests/e2e/*.test.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": ["src/", "scripts/", "cordis.patch.yml", "README.md"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-projection": "*"
  },
  "dependencies": {
    "@dsh-plugin-evaluation/portable-runner": "file:../dsh-plugin-evaluation-portable-runner",
    "zod": "^3.24.0"
  }
}
